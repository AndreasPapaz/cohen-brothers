# Environment variables for Cohen Brothers Judo Club membership system
# Copy this to .env and fill in real values (never commit .env!)

# Stripe (use test keys for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Resend
RESEND_API_KEY=re_...

# Cron authentication
CRON_SECRET=your-random-secret-here

# Club settings
CLUB_TZ=America/Chicago
SITE_URL=http://localhost:3000

# Demo mode (set to 'true' to use in-memory SQLite instead of Supabase)
DEMO_MODE=false
